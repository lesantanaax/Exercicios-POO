
public class Cliente
{
    public string Nome { get; set; }
    public string CPF { get; set; }

    public Cliente(string nome, string cpf)
    {
        Nome = nome;
        CPF = cpf;
    }
}


public class ContaBancaria
{

    public Cliente Titular { get; set; }
    public decimal Saldo { get; private set; }

    public ContaBancaria(Cliente titular)
    {
        Titular = titular;
    }

    public void Depositar(decimal valor)
    {
        if (valor > 0) Saldo += valor;
    }
}


class Program
{
    static void Main()
    {
      
        Cliente jose = new Cliente("José Silva", "123.456.789-00");

 
        ContaBancaria contaDoJose = new ContaBancaria(jose);

        contaDoJose.Depositar(1000);

        Console.WriteLine($"Titular: {contaDoJose.Titular.Nome}");
        Console.WriteLine($"CPF: {contaDoJose.Titular.CPF}");
        Console.WriteLine($"Saldo: R$ {contaDoJose.Saldo}");
    }
}





