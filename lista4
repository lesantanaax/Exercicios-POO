using System;
using System.Collections.Generic;
using System.Linq;
using System.Text;
using System.Threading.Tasks;

namespace prova_estudo
{
    internal class Curso
    {
        public string nomeCurso;
        public int cargaHoraria;


    }
}


using System;
using System.Collections.Generic;
using System.Globalization;
using System.Linq;
using System.Text;
using System.Threading.Tasks;

namespace prova_estudo
{
    internal class Aluno
    {
        public string nomeAluno;
        public bool trocarCurso = false;
        public List<Curso> Cursos = new List<Curso>();

        public void MatricularAluno(Curso curso)
        {
            Cursos.Add(curso);
        }

        public void ExibirInformacoes(Aluno aluno, Curso curso)
        {
            Console.WriteLine($"Nome do Aluno: {nomeAluno}");
            Console.WriteLine($"Nome do Curso: {curso.nomeCurso}");
            Console.WriteLine($"Nome do Curso: {curso.cargaHoraria}");

        }

        public void AlterarCurso(Aluno aluno, Curso cursoRemover, Curso cursoIncluir)
        {
            if (cursoRemover.nomeCurso != cursoIncluir.nomeCurso) {
                Cursos.Remove(cursoRemover);
                Cursos.Add(cursoIncluir);

                Console.WriteLine($"Alterando de : {cursoRemover.nomeCurso} Para: {cursoIncluir.nomeCurso}");
            }
            else
            {
                Console.WriteLine("Erro ao trocar de curso!");
            }
        }
    }
}

