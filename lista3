 public class Circulo
    {
    
        public double raio;
    
        public void CalcularArea(double raio)
        {
            double resultado = Math.PI * Math.Pow(raio, 2);
            Console.WriteLine($"A area é: {resultado}");
        }

       public void CalcularCircunferencia(double raio)
        {
            double resultado = 2 * Math.PI * raio;
            Console.WriteLine($"A circunferencia é: {resultado}");
        }
    }

MAIN:
Circulo circulo = new Circulo();
double teste = circulo.raio = 4.0;
circulo.CalculaArea(teste);
circulo.CalculaCircunferencia(teste);

