 public class Livro
    {
    
        public string titulo;
        public string autor;
        public int paginas;
        public int paginaAtual;

    
        public void AvancarPagina(int quantidade)
        {
            int paginaAtual += quantidade;
            Console.WriteLine($"A pagina atual é: {paginaAtual}");
        }
        public void ExibirProgresso()
        {
            int progresso = paginas - paginaAtual;
            Console.WriteLine($"A pagina atual é: {paginaAtual}");
            Console.WriteLine($"Progresso: {progresso}");
        }
}
