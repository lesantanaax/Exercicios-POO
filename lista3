    public class Carro
    {
        public string marca;
        public string modelo;
        public double velocidadeAtual;

        public void Acelerar(double valor)
        {
            velocidadeAtual += valor;
            Console.WriteLine($"Acelerando... Velocidade atual: {velocidadeAtual} km/h");
        }
        public void Frear(double valor)
        {
            velocidadeAtual -= valor;
            if (velocidadeAtual < 0)
                velocidadeAtual = 0;
            Console.WriteLine($"Freando... Velocidade atual: {velocidadeAtual} km/h");
        }
         public void ExibirVelocidade()
        {
            Console.WriteLine($"Ficha");
            Console.WriteLine($"Modelo: {marca}");
            Console.WriteLine($"Marca: {modelo}");
            Console.WriteLine($"Velocidade atual: {velocidadeAtual} km/h");
        }

    }

